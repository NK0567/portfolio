# URL publique de l'API, vue par le NAVIGATEUR (administration, formulaire de contact).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL publique du site, utilisée pour le sitemap, robots.txt et les balises Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facultatif : URL de l'API vue par le SERVEUR Next (rendu des pages publiques).
# Utile en Docker, où le serveur joint l'API par le réseau interne (http://api:8080/api).
# API_INTERNAL_URL=

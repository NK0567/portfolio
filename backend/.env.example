# ============================================
#  Serveur
# ============================================
PORT=8080
NODE_ENV=development

# ============================================
#  Base de données
#  Caractères spéciaux du mot de passe à encoder : @ -> %40, # -> %23, : -> %3A
# ============================================
DATABASE_URL="mysql://root:motdepasse@localhost:3306/portfolio_db"

# ============================================
#  JWT — générer chaque secret avec : openssl rand -hex 64
#  Les deux DOIVENT être différents. Minimum 32 caractères.
# ============================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================
#  CORS — plusieurs origines séparées par des virgules
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
#  Seed (npm run db:seed) — 12 caractères minimum
# ============================================
SEED_ADMIN_EMAIL=admin@portfolio.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

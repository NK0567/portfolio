{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "API du portfolio - Node.js, Express 5, Prisma, MySQL",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "uploads:import": "tsx scripts/import-uploads.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}

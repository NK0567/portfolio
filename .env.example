# Variables du docker-compose.yml (déploiement). Copier vers .env et remplir.

# Adresses publiques, sans barre finale
SITE_URL=https://boris-ngouadjeu.com
API_URL=https://api.boris-ngouadjeu.com

# Base de données : mots de passe longs et aléatoires (openssl rand -hex 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT : deux valeurs DIFFÉRENTES, 32 caractères minimum (openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Compte administrateur créé par `docker compose exec api npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
